# ============================================
# DATABASE (Supabase)
# ============================================
# Get from Supabase Dashboard > Settings > Database
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-supabase-db-password
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# ============================================
# SUPABASE (Client-side)
# ============================================
# Get from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# SECURITY
# ============================================
SECRET_KEY=generate-with-openssl-rand-base64-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# SERVER
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# ============================================
# CORS (for Vercel frontend)
# ============================================
CORS_ORIGINS=["https://dorsadesign.ir","https://dorsadesign-git-main-yourname.vercel.app","http://localhost:5173"]

# ============================================
# UPLOAD (Supabase Storage)
# ============================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=https://dorsadesign.ir